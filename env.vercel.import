# DATABASE_URL - Neon pooled Postgres URL (required)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# DEMO_API_KEY - owner desk sign-in (change in production)
DEMO_API_KEY=lens_demo_key_001

# Seed providers keep the Capstone demo at $0.00
VISION_PROVIDER=seed
EMBEDDING_PROVIDER=seed
OPENAI_API_KEY=

SIM_THRESHOLD=0.42
CONF_THRESHOLD=0.72
MAX_BATCH_USD=2.5
JOB_LEASE_MS=30000
JOB_MAX_ATTEMPTS=3
