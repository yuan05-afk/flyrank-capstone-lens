# Neon Postgres (pooled connection string recommended for Vercel serverless)
# Example: postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Demo session key (sign-in cookie value; set a long random value in production)
DEMO_API_KEY="lens_demo_key_001"

# Production demo: use seed providers ($0, deterministic). Optional live path needs OPENAI_API_KEY.
VISION_PROVIDER="seed"
EMBEDDING_PROVIDER="seed"
OPENAI_API_KEY=""

# Matching and guard thresholds (defaults match graded eval)
SIM_THRESHOLD="0.42"
CONF_THRESHOLD="0.72"

# Batch spend cap and worker lease settings
MAX_BATCH_USD="2.5"
JOB_LEASE_MS="30000"
JOB_MAX_ATTEMPTS="3"
